{
  "manifest_version": 3,
  "name": "FLECTO — 쉬운 화면",
  "version": "0.1.0",
  "description": "원래 사이트를 큰 글씨와 단계별 화면으로 이용합니다. 입력과 제출은 사용자가 직접 합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FLECTO 쉬운 화면 열기"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
