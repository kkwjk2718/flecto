{
  "name": "flecto",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "FLECTO accessible Chrome assistant with verified source-DOM bindings",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/check-repository.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "node scripts/build.mjs",
    "dev": "tsx scripts/dev.ts",
    "doctor": "tsx scripts/doctor.ts",
    "test:fixture": "playwright test --config playwright.config.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "demo:start": "tsx scripts/demo.ts",
    "demo:reset": "tsx scripts/reset.ts",
    "release:pack": "tsx scripts/release.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "fastify": "5.12.5",
    "@fastify/static": "8.3.0",
    "@fastify/cookie": "11.1.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "@vitejs/plugin-react": "5.2.0",
    "vitest": "4.1.11",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/chrome": "0.3.4",
    "tsx": "4.23.15",
    "jsdom": "27.4.0"
  }
}
